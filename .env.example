# Smee URL for forwarding GitHub webhooks to local kind cluster.
# Create one at https://hook.pipelinesascode.com
AAC_SMEEURL=

# Webhook secret (required) — must match what you configured on GitHub.
GITHUB_WEBHOOK_SECRET=

# GitHub App credentials (optional) — only needed if using a GitHub App.
# Not required for plain webhook + PAT setups.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=

# Repository configuration — used by hack/dev/kind/setup-repo.sh
REPO_URL=https://github.com/owner/repo
REPO_NAME=my-repo
REPO_NAMESPACE=agents-as-code-system

# GitHub PAT with repo scope — used for git_provider.secret on the Repository CR.
GITHUB_TOKEN=

# AI / LLM settings (optional) — populates spec.settings.ai on the Repository CR.
# Leave AI_ENABLED empty or "false" to skip.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
